Options -Indexes
# Yuklenen dosyalar arasinda betik calistirilmasini engelle
<FilesMatch "\.(php|phtml|phar|php\d|pl|py|cgi|sh)$">
    Require all denied
</FilesMatch>
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
# Yüklenen dosyaları yalnızca bildirilen türüyle (resim) yorumla
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
</IfModule>
